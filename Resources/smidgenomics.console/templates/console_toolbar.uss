
.sm-console__toolbar {
	border-color:var(--sm-console-divider-color, var(--sm-console-divider-color-default, white));
	border-bottom-width: 1px;
	display: flex;
	flex-grow:0;
	flex-direction: row;
	height:var(--sm-console-toolbar-height, 50px);
	min-height:var(--sm-console-toolbar-height, 50px);
	--sm-console-font-default:resource("smidgenomics.console/{inconsolata}");
}

.sm-console__toolbar__button {
	aspect-ratio:1;
	flex-grow:0;
	height:100%;
	padding:var(--sm-console-toolbar-spacing, 10px);
	margin:0;
	background-color:transparent;
	border-width: 0;
	opacity:0.8;
}

/* right floating controls */
.sm-console__toolbar__item--right {
	border-color: var(--sm-console-divider-color, var(--sm-console-divider-color-default, white));
	border-left-width: 1px;
}

/* left floating controls */
.sm-console__toolbar__item--left {
	border-color: var(--sm-console-divider-color, var(--sm-console-divider-color-default, white));
	border-right-width: 1px;
}

.sm-console__toolbar__filter {
	display: flex;
	flex-direction: row;
	-unity-font-definition: var(--sm-console-font, var(--sm-console-font-default));
	font-size: var(--sm-console-log-font-size, 25px);
	color:white;
}

.sm-console__toolbar__filter__label {
	font-size: var(--sm-console-log-font-size, 25px);
	-unity-text-align: middle-center;
}

.sm-console__toolbar__filter__dropdown {
	margin:0;
	padding:0;
}

.sm-console__toolbar__filter__icon {
	height:var(--sm-console-toolbar-height, 50px);
	aspect-ratio:1;
	padding:var(--sm-console-toolbar-spacing, 10px);
	opacity:0.5;
}

.sm-console__toolbar__filter__dropdown .unity-base-field__input {
	margin:0;
	background-color:transparent;
	border-width:0;
}

.sm-console__toolbar__filter__dropdown .unity-text-element {
	background-color:transparent;
}

.sm-console__toolbar__filter__dropdown .unity-base-dropdown__container-inner {
	background-color:transparent;
}

/* button hovered */
.sm-console__toolbar__button:hover {
	background-color:#fff1;
}

